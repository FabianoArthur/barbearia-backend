# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# --- PostgreSQL (used by docker-compose and by DATABASE_URL below) ---
POSTGRES_USER=barbearia
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=barbearia
POSTGRES_PORT=5432
DATABASE_URL="postgresql://barbearia:change-me-local-only@localhost:5432/barbearia?schema=public"

# --- Auth ---
# Required, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Auth cookies are marked Secure automatically when NODE_ENV=production.
# POST /auth/register lets the caller pick any role. Unset = open outside production,
# closed when NODE_ENV=production. Set explicitly to true/false to override.
# ALLOW_PUBLIC_REGISTRATION=

# --- Field encryption (CPF / phone) ---
# Required, 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Seeds (npm run prisma:seed / prisma:test-seed), min. 8 chars ---
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# --- Redis (BullMQ reminders + cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HTTP ---
CORS_ORIGIN=http://localhost:3001
# Global rate limit per client IP (defaults: 20 requests / 60000 ms)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Timezone for working hours / slot calculations (IANA timezone)
APP_TIMEZONE=America/Sao_Paulo

# Link sent to clients to confirm an appointment
PUBLIC_CONFIRMATION_URL=https://example.com/confirm

# --- WhatsApp reminders via Twilio (optional; without credentials sends fail and are logged) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
